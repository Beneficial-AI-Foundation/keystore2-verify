                let o ← core.time.Duration.checked_mul d i1
                let d1 ← apc.RateInfo.ONE_DAY
                ok (core.option.Option.unwrap_or o d1)
              else apc.RateInfo.ONE_DAY
            else apc.RateInfo.ONE_DAY
        else
          if 6#u32 <= self.counter
          then
            if self.counter <= 16#u32
            then
              do
              let d ← core.time.Duration.from_secs 60#u64
              let i ← self.counter - 6#u32
              let i1 ← 1#u32 <<< i
              let o ← core.time.Duration.checked_mul d i1
              let d1 ← apc.RateInfo.ONE_DAY
              ok (core.option.Option.unwrap_or o d1)
            else apc.RateInfo.ONE_DAY
          else apc.RateInfo.ONE_DAY
      let elapsed ← std.time.Instant.elapsed self.timestamp
      core.time.Duration.checked_sub back_off elapsed
  else
    let back_off ←
      if 3#u32 <= self.counter
      then
        if self.counter <= 5#u32
        then core.time.Duration.from_secs 30#u64
        else
          if 6#u32 <= self.counter
          then
