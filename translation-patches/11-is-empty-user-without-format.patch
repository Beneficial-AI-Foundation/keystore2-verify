     pub fn is_empty_user(&self, user: AndroidUserId) -> Result<bool> {
         let mut user_path = self.path.clone();
-        user_path.push(format!("user_{}", user.0));
+        user_path.push({ let mut dir = "user_".to_owned(); dir.push_str(&user.0.to_string()); dir });
